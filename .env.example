# Google GenAI provider: gemini | ollama | mock. Defaults to gemini when GEMINI_API_KEY is set.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional comma-separated model chain: e.g. gemini-2.5-flash,gemini-2.5-pro
GEMINI_MODELS=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Firebase web config (public by design; access is enforced by firestore.rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

